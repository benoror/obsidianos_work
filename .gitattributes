# Merge strategy: always keep local version for these paths when merging
# from obsidianos_work (the public generic upstream). These files contain
# personal data, vault-specific content, or local overrides.
#
# Requires the "ours" merge driver:
#   git config merge.ours.driver true
#
# The sync script (.scripts/sync-upstream.sh) auto-configures this on first run.

# Personal / sensitive
USER.md merge=ours
Tracker.md merge=ours
.env merge=ours
.cursor/mcp.json merge=ours

# Vault content (meetings, people, teams, notes)
Meetings/** merge=ours
Teams/** merge=ours
Recaps/** merge=ours
ObsAI/** merge=ours
Misc/** merge=ours
Archive/** merge=ours
Trackers/** merge=ours
ToDo's.md merge=ours

# Templates (upstream has generic versions, keep local customizations)
Templates/** merge=ours
