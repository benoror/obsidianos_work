properties:
  note.Team:
    displayName: Team(s)
views:
  - type: table
    name: Active
    filters:
      and:
        - file.name.startsWith("@")
        - file.folder == "Teams/People"
    order:
      - file.name
      - FullName
      - Team
      - Location
      - Office
      - file.tags
      - file.ctime
    sort:
      - property: file.name
        direction: ASC
      - property: Team
        direction: ASC
    columnSize:
      note.Team: 223
  - type: cards
    name: By Team
    filters:
      and:
        - file.name.startsWith("@")
        - file.folder == "Teams/People"
    groupBy:
      property: Team
      direction: ASC
    order:
      - file.name
      - FullName
      - Location
      - Office
      - Team
    sort:
      - property: Team
        direction: ASC
